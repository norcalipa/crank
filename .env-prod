ENV=prod
DJANGO_SETTINGS_MODULE=crank.settings
DB_HOST=10.2.2.10
DB_NAME=crank
DB_USER=crank
DB_PORT=3306
PYTHON_UNBUFFERED=1
REDIS_MASTER_URL=redis://redis-master:6379/0
REDIS_SLAVE_URL=
CACHE_TTL=60
# LLM gateway: offline FakeLLMProvider by default (no network calls) so a
# live provider is never contacted until a real adapter + key are configured.
# INTERACTIVE_AGENT_ENABLED stays disabled until secrets/policies are ready.
LLM_PROVIDER=crank.agents.llm:FakeLLMProvider
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_PER_USER_COST_LIMIT_USD=0
LLM_PRICE_PER_1K_TOKENS_USD=0
INTERACTIVE_AGENT_ENABLED=false
